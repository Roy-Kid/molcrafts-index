# Copy to `.env` for local use, and set the same key in the Cloudflare Pages project
# (Settings → Environment variables) for the deployed site.
#
# Only variables prefixed PUBLIC_ are inlined into the client bundle by rsbuild. Never put
# a secret behind that prefix — it ships to every visitor.

# Google Analytics 4 measurement ID. Leave unset to build with no tracker at all, which is
# what local dev and preview builds should do.
PUBLIC_GA_ID=
