{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    /* Linting */
    "strict": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  /* `scripts` consumes `src/lib` types (copy, ecosystem, routes) and runs at build
     time. It stayed outside this gate once, and a copy-shape rename shipped a
     build-breaking stale reference with `typecheck` and `lint` both green. */
  "include": ["src", "src/types/*.d.ts", "scripts"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
